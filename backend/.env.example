# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543, add ?pgbouncer=true). Used by the app.
DATABASE_URL=
# Direct connection (port 5432). Used by migrations.
DIRECT_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-code-4

PORT=5000
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# Optional (existing)
# GITHUB_TOKEN=
# MAX_REPO_ZIP_MB=100
# REPO_DOWNLOAD_TIMEOUT_MS=60000
