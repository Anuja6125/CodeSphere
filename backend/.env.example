# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543, add ?pgbouncer=true). Used by the app.
DATABASE_URL=
# Direct connection (port 5432). Used by migrations.
DIRECT_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-code-4
# Embedding speed. Defaults fit Voyage's free tier (slow: ~2 chunks per 21 s).
# With billing enabled on Voyage, use 64 and 0.
VOYAGE_BATCH_SIZE=2
VOYAGE_BATCH_DELAY_MS=21000

PORT=5000
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# Optional (existing)
# GITHUB_TOKEN=
# MAX_REPO_ZIP_MB=100
# REPO_DOWNLOAD_TIMEOUT_MS=60000
